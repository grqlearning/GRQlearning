<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GRQ Investment Learning — Learn to invest before you invest</title>
<meta name="description" content="Plain-English courses on index funds, crypto, and high-growth investing. From $5 a month.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#EEF3EA;
    --grid:#D3E0CC;
    --ink:#16301F;
    --ink-soft:#4A5E50;
    --pen:#2B4C9B;
    --pen-dark:#1F3876;
    --marker:#F4D84A;
    --margin:#C8423A;
    --display:"Bricolage Grotesque", system-ui, sans-serif;
    --body:"Source Serif 4", Georgia, serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:18px;line-height:1.65;-webkit-font-smoothing:antialiased}
  h1,h2,h3{font-family:var(--display);line-height:1.08;margin:0;letter-spacing:-.015em}
  p{margin:0 0 1em}
  a{color:var(--pen)}
  :focus-visible{outline:3px solid var(--pen);outline-offset:3px;border-radius:2px}

  .wrap{max-width:1160px;margin:0 auto;padding:0 32px 0 96px;position:relative}
  /* the ledger margin line */
  .sheet{position:relative}
  .sheet::before{content:"";position:absolute;top:0;bottom:0;left:max(64px, calc((100vw - 1160px)/2 + 64px));width:2px;background:var(--margin);opacity:.55;pointer-events:none}

  /* header */
  .top{border-bottom:1px solid var(--grid)}
  .top .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:18px;padding-bottom:18px}
  .logo{display:flex;align-items:baseline;gap:10px;text-decoration:none;color:var(--ink)}
  .logo b{font-family:var(--display);font-weight:800;font-size:1.75rem;letter-spacing:-.03em}
  .logo span{font-size:.95rem;color:var(--ink-soft)}
  .nav{display:flex;align-items:center;gap:28px}
  .nav a{color:var(--ink);text-decoration:none;font-size:1rem}
  .nav a:hover{text-decoration:underline;text-underline-offset:4px}

  .btn{display:inline-block;font-family:var(--display);font-weight:700;font-size:1.05rem;text-decoration:none;background:var(--pen);color:#fff;padding:14px 24px;border-radius:6px;border:2px solid var(--ink);box-shadow:0 4px 0 var(--ink);transition:transform .08s, box-shadow .08s;cursor:pointer}
  .btn:hover{background:var(--pen-dark)}
  .btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}
  .btn.small{padding:9px 16px;font-size:.95rem;box-shadow:0 3px 0 var(--ink)}
  .btn.ghost{background:transparent;color:var(--ink)}
  .btn.ghost:hover{background:#fff}

  section{padding:96px 0}
  section + section{border-top:1px solid var(--grid)}
  .section-head{max-width:640px;margin-bottom:48px}
  .section-head h2{font-size:clamp(2rem,4vw,2.75rem);margin-bottom:14px}
  .section-head p{color:var(--ink-soft)}

  /* hero */
  .hero{padding-top:72px}
  .hero .wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:64px;align-items:center}
  .hero h1{font-size:clamp(2.7rem,6vw,4.7rem);font-weight:800;letter-spacing:-.035em;line-height:1;margin-bottom:24px}
  .lede{font-size:1.25rem;max-width:30ch;color:var(--ink)}
  .cta-row{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin:32px 0 16px}
  .fine{font-size:.9rem;color:var(--ink-soft)}

  /* calculator: graph paper panel */
  .calc{background-color:#F8FBF5;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:22px 22px;border:2px solid var(--ink);border-radius:8px;padding:28px 28px 22px;box-shadow:8px 8px 0 var(--ink)}
  .calc h2{font-size:1.35rem;margin-bottom:20px}
  .field{margin-bottom:18px}
  .field-row{display:flex;justify-content:space-between;align-items:baseline;font-size:1rem}
  .field-row output{font-family:var(--display);font-weight:700;font-size:1.1rem;font-variant-numeric:tabular-nums}
  input[type=range]{width:100%;accent-color:var(--pen);margin:6px 0 0;height:28px}
  fieldset{border:0;padding:0;margin:0 0 22px}
  legend{font-size:1rem;margin-bottom:8px;padding:0}
  .seg{display:grid;grid-template-columns:repeat(3,1fr);border:2px solid var(--ink);border-radius:6px;overflow:hidden;background:#fff}
  .seg input{position:absolute;opacity:0;pointer-events:none}
  .seg label{text-align:center;padding:8px 4px;cursor:pointer;font-size:.92rem;line-height:1.25}
  .seg label + input + label,.seg input + label ~ label{border-left:2px solid var(--ink)}
  .seg label b{display:block;font-family:var(--display);font-size:1.05rem}
  .seg input:checked + label{background:var(--ink);color:var(--paper)}
  .seg input:focus-visible + label{outline:3px solid var(--pen);outline-offset:-5px}
  .result{border-top:2px dashed var(--ink);padding-top:18px}
  .result p{margin:0 0 4px;font-size:1.05rem}
  .big{font-family:var(--display);font-weight:800;font-size:clamp(2.2rem,4.5vw,3rem);letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1.1;display:inline-block;background:linear-gradient(transparent 55%, var(--marker) 55%, var(--marker) 92%, transparent 92%);padding:0 4px;margin:2px 0 6px}
  .multiple{font-weight:600}
  .calc .fine{margin-top:12px;margin-bottom:0}

  /* tracks */
  .tracks{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
  .tracks li{display:grid;grid-template-columns:260px 1fr;gap:40px;padding:32px 0;border-bottom:1px solid var(--grid)}
  .tracks h3{font-size:1.55rem;margin-bottom:6px}
  .tracks .count{font-size:.95rem;color:var(--ink-soft)}
  .tracks p{max-width:62ch;margin:0}

  /* steps */
  .steps{list-style:none;counter-reset:s;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:32px}
  .steps li{counter-increment:s;position:relative;padding-top:64px}
  .steps li::before{content:counter(s);position:absolute;top:0;left:0;font-family:var(--display);font-weight:800;font-size:2.4rem;line-height:1;color:var(--pen)}
  .steps h3{font-size:1.2rem;margin-bottom:8px}
  .steps p{font-size:1rem;color:var(--ink-soft);margin:0}

  /* pricing */
  .plans{display:grid;grid-template-columns:1fr;max-width:520px;border:2px solid var(--ink);border-radius:8px;background:#fff;overflow:hidden}
  .plan{padding:32px 28px;display:flex;flex-direction:column}
  .plan + .plan{border-left:2px solid var(--ink)}
  .plan.feature{background:#FFFBE6}
  .plan h3{font-size:1.3rem;margin-bottom:4px}
  .plan .note{font-size:.95rem;color:var(--ink-soft);min-height:1.6em;margin-bottom:12px}
  .price{font-family:var(--display);font-weight:800;font-size:3rem;letter-spacing:-.03em;line-height:1}
  .price small{font-size:1rem;font-weight:500;letter-spacing:0;color:var(--ink-soft)}
  .plan ul{margin:22px 0 28px;padding-left:20px;font-size:1rem;flex:1}
  .plan li{margin-bottom:6px}
  .plan .btn{text-align:center}

  /* free lesson */
  .free .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end}
  .free h2{font-size:clamp(1.8rem,3.5vw,2.4rem);margin-bottom:12px}
  .free p{color:var(--ink-soft);margin:0}
  .signup label{display:block;font-size:1rem;margin-bottom:8px}
  .signup-row{display:flex;gap:12px}
  .signup input{flex:1;min-width:0;font:inherit;font-size:1rem;padding:13px 14px;border:2px solid var(--ink);border-radius:6px;background:#fff;color:var(--ink)}
  .signup .msg{font-size:.95rem;margin:10px 0 0;min-height:1.5em}
  .signup .msg.err{color:var(--margin)}

  /* faq */
  .faq{max-width:760px}
  .faq details{border-bottom:1px solid var(--grid)}
  .faq details:first-of-type{border-top:2px solid var(--ink)}
  .faq summary{cursor:pointer;list-style:none;font-family:var(--display);font-weight:700;font-size:1.2rem;padding:22px 40px 22px 0;position:relative}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";position:absolute;right:4px;top:18px;font-size:1.6rem;font-weight:500;transition:transform .2s}
  .faq details[open] summary::after{transform:rotate(45deg)}
  .faq details p{padding-bottom:22px;margin:0;max-width:64ch}

  /* footer */
  footer{border-top:2px solid var(--ink);padding:48px 0 64px;font-size:.92rem;color:var(--ink-soft)}
  footer .wrap{display:grid;grid-template-columns:1fr 2fr;gap:48px}
  footer .links{display:flex;gap:20px;margin-top:12px}
  footer .links a{color:var(--ink)}
  .disclaimer{margin:0;max-width:70ch}

  @media (max-width:960px){
    .hero .wrap,.free .wrap,footer .wrap{grid-template-columns:1fr}
    .steps{grid-template-columns:1fr 1fr}
    .plans{grid-template-columns:1fr}
    .plan + .plan{border-left:0;border-top:2px solid var(--ink)}
    .tracks li{grid-template-columns:1fr;gap:10px}
  }
  @media (max-width:640px){
    body{font-size:17px}
    .wrap{padding:0 20px 0 44px}
    .sheet::before{left:28px}
    .nav a:not(.btn){display:none}
    section{padding:64px 0}
    .steps{grid-template-columns:1fr}
    .calc{padding:22px 18px 18px;box-shadow:5px 5px 0 var(--ink)}
    .signup-row{flex-direction:column}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *{transition:none!important}
  }
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <a class="logo" href="#" aria-label="GRQ Investment Learning home"><b>GRQ</b><span>Investment Learning</span></a>
    <nav class="nav" aria-label="Main">
      <a href="#courses">Courses</a>
      <a href="#pricing">Pricing</a>
      <a href="#faq">FAQ</a>
      <a data-login href="#">Log in</a>
      <a class="btn small" data-plan="standard" href="#pricing">Start for $5</a>
    </nav>
  </div>
</header>

<main class="sheet">

  <section class="hero">
    <div class="wrap">
      <div>
        <h1>Learn to invest before you invest.</h1>
        <p class="lede">Plain-English courses on index funds, crypto, and high-growth strategies. $5 a month for your first three months.</p>
        <div class="cta-row">
          <a class="btn" data-plan="standard" href="#pricing">Start for $5 a month</a>
          <a class="btn ghost" href="#courses">See the courses</a>
        </div>
        <p class="fine">Then $15 a month. Cancel anytime. You don't need a brokerage account to start.</p>
      </div>

      <div class="calc" aria-labelledby="calc-title">
        <h2 id="calc-title">See what steady investing can grow into</h2>

        <div class="field">
          <div class="field-row"><label for="amt">Invest each month</label><output id="amt-out" for="amt">$200</output></div>
          <input type="range" id="amt" min="25" max="1000" step="25" value="200">
        </div>

        <div class="field">
          <div class="field-row"><label for="yrs">For this many years</label><output id="yrs-out" for="yrs">20</output></div>
          <input type="range" id="yrs" min="1" max="40" step="1" value="20">
        </div>

        <fieldset>
          <legend>Average yearly return</legend>
          <div class="seg">
            <input type="radio" name="rate" id="r4" value="0.04"><label for="r4"><b>4%</b>Cautious</label>
            <input type="radio" name="rate" id="r7" value="0.07" checked><label for="r7"><b>7%</b>Moderate</label>
            <input type="radio" name="rate" id="r10" value="0.10"><label for="r10"><b>10%</b>Optimistic</label>
          </div>
        </fieldset>

        <div class="result" aria-live="polite">
          <p>You put in <strong id="contrib">$48,000</strong>. It could grow to</p>
          <span class="big" id="total">$104,185</span>
          <p class="multiple" id="multiple">That's 2.2× what you put in.</p>
        </div>
        <p class="fine">Hypothetical example, compounded monthly. Real returns change year to year and can be negative.</p>
      </div>
    </div>
  </section>

  <section id="courses">
    <div class="wrap">
      <div class="section-head">
        <h2>Three tracks, one subscription</h2>
        <p>Every member starts with a short foundations course, then goes deep on whatever fits their goals.</p>
      </div>
      <ul class="tracks">
        <li>
          <div><h3>Index &amp; equity funds</h3><span class="count">14 lessons</span></div>
          <p>The slow, proven way most people build wealth. What index funds and ETFs are, how fees quietly eat returns, how to compare funds, and how to automate your contributions so investing happens without willpower.</p>
        </li>
        <li>
          <div><h3>Crypto, minus the hype</h3><span class="count">12 lessons</span></div>
          <p>How blockchains and the major coins actually work, how to buy and store crypto safely, how to spot scams and rug pulls, and how people decide how much of a portfolio belongs in something this volatile.</p>
        </li>
        <li>
          <div><h3>Chasing 10×</h3><span class="count">10 lessons</span></div>
          <p>How outsized returns really happen: compounding, concentrated bets, early-stage assets, and the math of risk. Includes case studies of big wins and the far more common big losses, so you know what you're signing up for.</p>
        </li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>How GRQ works</h2>
      </div>
      <ol class="steps">
        <li><h3>Subscribe for $5</h3><p>Your first three months are $5 a month, then $15. Cancel from your account whenever you want.</p></li>
        <li><h3>Start with the foundations</h3><p>Budgeting to invest, account types like 401(k)s, IRAs, and brokerage accounts, and how risk works.</p></li>
        <li><h3>Pick a track</h3><p>Go deep on funds, crypto, or high-growth strategies at your own pace.</p></li>
        <li><h3>Put it to work</h3><p>Apply what you learned when you open real accounts and make real decisions.</p></li>
      </ol>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <div class="section-head">
        <h2>One plan, every course</h2>
        <p>Your first three months are $5 a month. Cancel anytime from your account.</p>
      </div>
      <div class="plans">
        <div class="plan feature">
          <h3>Standard</h3>
          <p class="note">Everything you need to start.</p>
          <div class="price">$5<small> / month for 3 months</small></div>
          <p class="fine" style="margin:8px 0 0">Then $15 a month.</p>
          <ul>
            <li>Foundations course</li>
            <li>All three tracks: funds, crypto, and Chasing 10×</li>
            <li>New lessons every month</li>
          </ul>
          <a class="btn" data-plan="standard" href="#">Start for $5 a month</a>
        </div>
      </div>
    </div>
  </section>

  <section class="free">
    <div class="wrap">
      <div>
        <h2>Not ready to pay? Take the first lesson free.</h2>
        <p>"How index funds work, in 12 minutes." We'll email it to you.</p>
      </div>
      <div class="signup">
        <label for="email">Email address</label>
        <div class="signup-row">
          <input type="email" id="email" autocomplete="email" placeholder="name@example.com">
          <button class="btn" id="send" type="button">Send me the lesson</button>
        </div>
        <p class="msg" id="msg" role="status"></p>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <div class="section-head"><h2>Questions</h2></div>
      <div class="faq">
        <details>
          <summary>Is this financial advice?</summary>
          <p>No. GRQ teaches general concepts and strategies. We don't tell you what to buy or manage your money. For advice about your specific situation, talk to a licensed financial professional.</p>
        </details>
        <details>
          <summary>Do I need money to start?</summary>
          <p>No. You can take every course before investing a dollar. When you're ready, the foundations course walks you through opening your first accounts.</p>
        </details>
        <details>
          <summary>Will this teach me how to 10× my money?</summary>
          <p>It will teach you how 10× returns happen and why they're rare. No course can promise returns, and anyone who does is selling you something riskier than a course.</p>
        </details>
        <details>
          <summary>Who's behind GRQ?</summary>
          <p>GRQ was founded by Jake, a finance graduate of New Mexico State University and former Division I pitcher, who teaches investing the way good coaches teach the game: fundamentals first, then reps.</p>
        </details>
        <details>
          <summary>What happens after the first three months?</summary>
          <p>Standard moves to $15 a month on your fourth billing date. We'll email you a reminder a week before the price changes, and you can cancel anytime before then without being charged the new price.</p>
        </details>
        <details>
          <summary>How do I cancel?</summary>
          <p>Select Manage subscription at the bottom of this page and sign in with the email you used to subscribe. Cancel there and you keep access until the end of the period you've paid for, and you won't be charged again.</p>
        </details>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap">
    <div>
      <a class="logo" href="#"><b>GRQ</b><span>Investment Learning</span></a>
      <div class="links"><a data-login href="#">Member log in</a><a data-portal href="#">Manage subscription</a><a href="#">Terms</a><a href="#">Privacy</a><a data-email href="#">Contact</a></div>
      <p style="margin-top:16px"><a data-email href="#" data-show-address>Email us</a></p>
      <p style="margin-top:4px">© 2026 GRQ Investment Learning</p>
    </div>
    <p class="disclaimer">GRQ Investment Learning provides general educational content only and is not a registered investment adviser or broker-dealer. Nothing on this site or in our courses is personalized investment, tax, or legal advice. Investing involves risk, including the possible loss of principal. Past performance does not guarantee future results. Cryptocurrencies are highly volatile and may lose all of their value. Calculator results are hypothetical illustrations, not predictions.</p>
  </div>
</footer>

<script>
  /* ---- Paste your GRQ email address here ---- */
  const CONTACT_EMAIL = "grqlearning@gmail.com";
  document.querySelectorAll("[data-email]").forEach(a => {
    if (CONTACT_EMAIL.includes("REPLACE")) { if (a.hasAttribute("data-show-address")) a.hidden = true; return; }
    a.href = "mailto:" + CONTACT_EMAIL;
    if (a.hasAttribute("data-show-address")) a.textContent = CONTACT_EMAIL;
  });

  /* ---- Paste your member-area login URL here (from Systeme.io) ---- */
  const MEMBER_LOGIN_URL = "REPLACE_LOGIN_URL";
  document.querySelectorAll("[data-login]").forEach(a => {
    if (!MEMBER_LOGIN_URL.includes("REPLACE")) a.href = MEMBER_LOGIN_URL;
  });

  /* ---- Stripe Payment Link for the Standard plan ----
     Sandbox (test) link below. Before launch, replace it with your LIVE
     payment link (starts with https://buy.stripe.com/ without "test_"). */
  const CHECKOUT_LINKS = {
    standard: "https://buy.stripe.com/test_bJe6oJ5DP4Wr0Z8aaG0Fi00"
  };
  const INTRO_PROMO_CODE = "GRQINTRO";  // $10 off for 3 months = $5/month intro
  document.querySelectorAll("[data-plan]").forEach(a => {
    const url = CHECKOUT_LINKS[a.dataset.plan];
    if (url && !url.includes("REPLACE")) a.href = url + "?prefilled_promo_code=" + INTRO_PROMO_CODE;
  });

  /* ---- Paste your Stripe customer portal login link here ---- */
  const PORTAL_URL = "REPLACE_PORTAL_URL";
  document.querySelectorAll("[data-portal]").forEach(a => {
    if (PORTAL_URL.includes("REPLACE")) { a.hidden = true; return; }
    a.href = PORTAL_URL;
  });

  /* ---- Growth calculator ---- */
  const $ = id => document.getElementById(id);
  const usd = n => n.toLocaleString("en-US", {style:"currency", currency:"USD", maximumFractionDigits:0});
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let shown = 104185, anim;

  function tween(to){
    cancelAnimationFrame(anim);
    if (reduce){ shown = to; $("total").textContent = usd(to); return; }
    const from = shown, start = performance.now(), dur = 350;
    const step = t => {
      const p = Math.min((t - start) / dur, 1), e = 1 - Math.pow(1 - p, 3);
      shown = from + (to - from) * e;
      $("total").textContent = usd(shown);
      if (p < 1) anim = requestAnimationFrame(step);
    };
    anim = requestAnimationFrame(step);
  }

  function calc(){
    const m = +$("amt").value, y = +$("yrs").value;
    const r = +document.querySelector("input[name=rate]:checked").value / 12;
    const n = y * 12;
    const fv = m * ((Math.pow(1 + r, n) - 1) / r);
    const put = m * n;
    const x = fv / put;
    $("amt-out").textContent = usd(m);
    $("yrs-out").textContent = y;
    $("contrib").textContent = usd(put);
    tween(Math.round(fv));
    $("multiple").textContent = x >= 10
      ? `That's ${x.toFixed(1)}× what you put in. Notice how long it took.`
      : `That's ${x.toFixed(1)}× what you put in.`;
  }
  ["amt","yrs"].forEach(id => $(id).addEventListener("input", calc));
  document.querySelectorAll("input[name=rate]").forEach(r => r.addEventListener("change", calc));
  calc();

  /* ---- Free lesson signup (connect to your email tool) ---- */
  $("send").addEventListener("click", () => {
    const v = $("email").value.trim(), msg = $("msg");
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)){
      msg.className = "msg err";
      msg.textContent = "Enter an email address like name@example.com.";
      $("email").focus();
      return;
    }
    // TODO: send `v` to Mailchimp, Kit (ConvertKit), or your course platform here
    msg.className = "msg";
    msg.textContent = "Sent. Check your inbox for the free lesson.";
    $("email").value = "";
  });
</script>
</body>
</html>
